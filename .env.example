# Chave de API da xAI (obrigatória)
XAI_API_KEY=xai-...

# Secret usado para validar assinatura dos webhooks da xAI (obrigatória)
XAI_SIGNING_SECRET=whsec_...

# URL interna do discador (sem barra final)
VB_BASE=http://discador:3000

# Token Bearer compartilhado somente entre bridge e voice-broadcast
VB_INTERNAL_TOKEN=troque-por-um-segredo-forte

# Porta WebSocket do mod_audio_stream (opcional, padrão 8830)
AUDIO_WS_PORT=8830

# Porta do servidor HTTP (opcional, padrão 8080)
PORT=8080
